            "text": "@charset \"utf-8\";\r\n*::selection{background:#4fae76; color:#fff; text-shadow:none;}\r\n*{margin:0;padding:0;}\r\nbody{font-size:14px; color:#000; font-family:\"Microsoft YaHei\",\"微软雅黑\",\"黑体\",sans-serif;}\r\nbody a{text-decoration:none; outline:none; -webkit-transition:all 0.3s; transition:all 0.3s;}\r\na:link,a:visited{color:#000;}\r\na:hover{color:#4fae76;}\r\ninput:focus{outline:0;}\r\na,area{blr:expression(this.onFocus=this.blur());}  /*for IE*/   \r\n:focus{-moz-outline-style:none; outline:none;}     /* for Firefox*/\r\nimg{border:0; outline:none; max-width:100%; vertical-align:top;}\r\nul,li{list-style-type:none;}\r\n.clear{clear:both; height:0;}\r\ntable,table td{border-collapse:collapse;}\r\n\r\n\r\n/* ie9以下警告 */\r\n.pageTips{position:fixed; z-index:10000; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.9);}\r\n.pageTips .container2{color:#fff; position:absolute; left:50%; top:50%; width:630px; margin-left:-315px; margin-top:-160px;}\r\n.pageTips .container2 a.close{display:none; width:50px; height:50px; position:absolute; z-index:1; left:auto; right:-15px; top:40px; bottom:auto; background:url(../../images/student/close.png) no-repeat center center;}\r\n.pageTips .container2 .img{text-align:center;}\r\n.pageTips .container2 .msg{font-size:18px; line-height:36px; padding-top:30px;}\r\n.pageTips .container2 a{color:#fff; text-decoration:underline;}\r\n\r\n.animate{-webkit-transition:all 0.3s; transition:all 0.3s;}\r\n.unselectable{-moz-user-select:-moz-none;-webkit-user-select:none;-ms-user-select:none;user-select:none;}\r\n.ellipsis{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}/*文字超出省略号...*/\r\n.nowrap{overflow:hidden;white-space:nowrap;}\r\n.justify{text-justify:inter-ideograph; text-align:justify;}/*文字两端对齐*/\r\n.box-shadow{box-shadow:10px 10px 50px rgba(143,151,146,0.21);}\r\n.hide{display:none !important;}\r\n\r\n.clamp2{display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;}\r\n.clamp3{display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;}\r\n.clamp4{display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden;}\r\n.clamp5{display:-webkit-box; -webkit-line-clamp:5; -webkit-box-orient:vertical; overflow:hidden;}\r\n.clamp6{display:-webkit-box; -webkit-line-clamp:6; -webkit-box-orient:vertical; overflow:hidden;}\r\n\r\n.txt-light-green{color:#95c238;}\r\n.txt-green{color:#4ca771;}\r\n.txt-orange{color:#ff7b26;}\r\n.txt-red{color:#f00;}\r\n.txt-white{color:#fff;}\r\n\r\n.bg-light-green{background-color:#f2fddc;}\r\n.bg-green{background-color:#4ca771;}\r\n.bg-orange{background-color:#ff7b26;}\r\n.bg-white{background-color:#fff;}\r\n\r\n/* 自定义弹出层 */\r\n.layerDiv{display:none;}\r\n.layerBox{border-radius:10px !important;}\r\n.layerBox .layui-layer-title{font-size:16px; font-weight:normal; color:#fff; background:#4fae76; padding:0 15px; -moz-user-select:-moz-none;-khtml-user-select:none;-webkit-user-select:none;-ms-user-select:none;user-select:none; border-radius:10px 10px 0 0;}\r\n.layerBox .layui-layer-setwin a{margin-left:0; background:url(../../images/student/close.png) no-repeat center center; background-size:contain;}\r\n.layerBox .layui-layer-setwin a:hover{transform:rotate(180deg); opacity:1;}\r\n.layerBox .layui-layer-btn{padding:10px 15px !important; background:#f8f8f8; border-top:1px solid #cfcfcf; border-radius:0 0 10px 10px;}\r\n.layerBox .layui-layer-btn a{margin-top:0;}\r\n.layerBox .layui-layer-btn .layui-layer-btn0{border-color:#4fae76; background-color:#4fae76;}\r\n.layerBox .layerDiv{padding:20px;}\r\n\r\n.oneBtn .layui-layer-btn a, .twoBtn .layui-layer-btn a{height:50px; line-height:50px; text-align:center; padding:0; border:0; background:#f1f1f1;}\r\n.oneBtn .layui-layer-btn a.layui-layer-btn0{width:100%; border-radius:0 0 10px 10px; color:#4694ff;}\r\n\r\n.twoBtn .layui-layer-btn a.layui-layer-btn0{width:50%; float:right; border-radius:0 0 10px 0; color:#4694ff;}\r\n.twoBtn .layui-layer-btn a.layui-layer-btn1{width:calc(50% - 1px); float:left; border-right:#cfcfcf 1px solid; border-radius:0 0 0 10px;}\r\n\r\n/* 线性按钮 */\r\n.line-btn{display:inline-block; *display:inline; zoom:1; height:30px; line-height:30px; padding:0 12px; color:#000 !important; border:#000 1px solid; white-space:nowrap; text-align:center; font-size:16px; border-radius:4px; -webkit-border-radius:4px; -moz-user-select:none; -webkit-user-select:none; -ms-user-select:none; outline:0; -webkit-appearance:none; transition:all 0.3s; -webkit-transition:all 0.3s; box-sizing:content-box; cursor:pointer; -webkit-appearance:button; vertical-align:top;background:none;}\r\n.line-btn .iconfont{font-size:18px; padding-right:6px;}\r\n.line-btn:hover{border-color:#4fae76 !important; color:#4fae76 !important;}\r\n\r\n\r\n.container{min-width:1260px; _width:1260px;}\r\n\r\n.w1260{width:1260px; margin:0 auto;}\r\n.w1260:after{display:block; content:\"\"; clear:both;}\r\n@media screen and (min-width:1920px){\r\n\t.bgFluid{background-size:100% 100% !important;}\r\n\t.bgCover{background-size:cover !important;}\r\n\t.bgContain{background-size:contain !important;}\r\n}\r\n\r\n/*页头*/\r\n.smart-community__head{height:902px; position:relative; overflow:hidden;}\r\n.smart-community__head__con{height:902px; position:relative; z-index:1;background:url(../../images/student/headBg.png) no-repeat center top;}\r\n.smart-community__logo{height:42px; padding:56px 0; background:url(../../images/student/logo02.png) no-repeat left center;}\r\n\r\n/*搜索*/\r\n.smart-community__search{width:152px; height:32px; background:#fff; -webkit-border-radius:32px; border-radius:32px; float:right; padding:0 4px 0 16px;}\r\n.smart-community__search .keyword{width:120px; height:32px; line-height:32px; font-size:14px; background:none; border:0; padding:0; margin:0; float:left;}\r\n.smart-community__search .keyword::placeholder{color:#9ea4a9;}\r\n.smart-community__search .search-btn{width:32px; height:32px; line-height:32px; text-align:center; font-size:18px; border:0; background:none; padding:0; margin:0; cursor:pointer; float:left; color:#9ea4a9;}\r\n.smart-community__search .search-btn:hover{color:#4fae76;}\r\n\r\n/*菜单*/\r\n.smart-community__menu{padding:0 12px; height:32px; background:#fff; -webkit-border-radius:32px; border-radius:32px; margin-right:10px; float:right;}\r\n.smart-community__menu li{padding:0 10px; height:32px; line-height:32px; float:left;}\r\n.smart-community__menu li a{display:block; height:32px; padding:0 8px; position:relative;}\r\n.smart-community__menu li a:before{display:block; content:\"\"; width:0; height:3px; background:#4fae76; position:absolute; left:50%; bottom:0; transform:translateX(-50%); -webkit-transition:all 0.3s; transition:all 0.3s;}\r\n.smart-community__menu li a i{font-size:20px; color:#b8c2c9; display:inline-block; height:32px; vertical-align:top; padding-right:5px;}\r\n.smart-community__menu li a:hover, .smart-community__menu li a:hover i{color:#4fae76;}\r\n.smart-community__menu li a:hover:before{width:100%;}\r\n\r\n\r\n/*个人信息*/\r\n.smart-community__student-info-box{position:absolute; left:50%; top:184px; transform:translateX(-50%); z-index:2;}\r\n.smart-community__student-info{width:376px; padding-bottom:25px; -webkit-border-radius:12px; border-radius:12px;}\r\n.smart-community__student-info .smart-community__item{margin:0 25px; border-bottom:#e3e3e3 1px solid;}\r\n/*当前学院*/\r\n.smart-community__current-college{height:49px; line-height:49px; padding:0 25px; border-bottom:#e3e3e3 1px solid; font-size:16px;}\r\n.smart-community__current-college a{display:block; height:28px; line-height:28px; font-size:13px; float:right; padding:0 16px; background:#4fae76; color:#fff; -webkit-border-radius:28px; border-radius:28px; margin-top:11px;}\r\n.smart-community__current-college a:hover{background:#ff7b26;}\r\n.smart-community__current-college i{display:inline-block; height:49px; vertical-align:top; font-size:24px; padding-right:3px; color:#4fae76;}\r\n.smart-community__current-college span{ display:inline-block; width:210px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}\r\n/*肖像*/\r\n.smart-community__portrait{padding:20px 0; display:flex; flex-direction:row; align-items:center; justify-content:center;}\r\n.smart-community__portrait__pic{display:block;width:72px; height:72px; border:#e4e4e4 3px solid; -webkit-border-radius:50%; border-radius:50%; background:#c0e0ff url(../../images/student/none.png) no-repeat center center; background-size:cover; position:relative;}\r\n.smart-community__portrait__pic p{height:72px; background-repeat:no-repeat; background-position:center top; background-size:cover; -webkit-border-radius:50%; border-radius:50%;}\r\n.smart-community__portrait__pic .iconfont{display:block; width:18px; height:18px; line-height:18px; text-align:center; background:rgba(130,210,170,0.3); color:rgba(0,0,0,0.3); border-radius:50%; font-size:8px; position:absolute; right:-5px; bottom:-1px;}\r\n.smart-community__portrait__pic:hover  .iconfont{background:rgba(130,210,170,0.6); color:rgba(255,0,0,0.6);}\r\n.smart-community__portrait__txt{margin-left:20px; flex:1;}\r\n.smart-community__student-name{line-height:24px; font-size:14px;}\r\n.smart-community__student-name span{display:inline-block; vertical-align:top; height:24px; line-height:24px;font-size:12px; color:#666;padding:2px 12px 0;}\r\n.smart-community__student-name span .v_separator{margin-left:5px;margin-right:5px;color:#ccc;}\r\n/*.smart-community__student-name span{display:inline-block; vertical-align:top; height:20px; line-height:20px; margin:2px 0 0 12px; background:#f2fddc; color:#95c238; font-size:12px; -webkit-border-radius:3px; border-radius:3px; padding:0 12px;} */\r\n.smart-community__student-address{line-height:20px; padding-top:7px; color:#9ea4a9;}\r\n\r\n.smart-community__student-btn{line-height:20px; padding-top:7px; text-align:right;}\r\n.smart-community__student-btn span{float:left; color:#9ea4a9;}\r\n.smart-community__student-btn span .iconfont{padding-right:2px;}\r\n.smart-community__student-btn a{display:inline-block; vertical-align:top; height:20px; line-height:20px; margin-right:20px; font-size:14px;}\r\n.smart-community__student-btn a .iconfont{font-size:14px; padding-right:3px;}\r\n.smart-community__student-btn a:last-of-type{margin-right:0;}\r\n.smart-community__student-btn a:link, .smart-community__student-btn a:visited{color:#4fae76;}\r\n.smart-community__student-btn a:hover{color:#ff7b26;}\r\n/*余额*/\r\n.smart-community__balance{height:48px; line-height:48px; text-align:right;}\r\n.smart-community__balance em{font-style:normal;}\r\n.smart-community__balance label{font-size:16px; float:left;}\r\n.smart-community__balance label em{display:inline-block; vertical-align:top; height:20px; line-height:20px; padding:0 10px; -webkit-border-radius:20px; border-radius:20px; font-size:12px; margin:14px 0 0 12px;}\r\n.smart-community__balance span {font-size:12px; color:#9ea4a9;}\r\n.smart-community__balance span em{font-family:Arial, Helvetica, sans-serif; font-size:17px; padding-left:8px; min-width:50px; display:inline-block; height:48px; line-height:48px; vertical-align:bottom;}\r\n.smart-community__balance  span a{position:relative;top:1px;}\r\n.smart-community__balance  span a i{color:#9ea4a9;}\r\n.smart-community__balance  span a:hover i{color:#f80808;}\r\n\r\n/*我的校园网*/\r\n.smart-community__my-campus-network{padding:11px 0;}\r\n.smart-community__my-campus-network h2{height:25px; line-height:25px; font-size:16px; font-weight:normal;}\r\n.smart-community__my-campus-network h2 span{float:right; color:#9ea4a9; font-size:12px;}\r\n.smart-community__my-campus-network h2 span button{display:inline-block; vertical-align:top; height:25px; line-height:25px; background:none; border:0; padding:0; margin:0 3px 0 0; font-size:12px; color:#9ea4a9; cursor:pointer;}\r\n.smart-community__my-campus-network h2 span button:hover{color:#4fae76;}\r\n.smart-community__my-campus-network ul{height:47px; display:flex; margin-top:8px;}\r\n.smart-community__my-campus-network ul li{flex:1; height:47px; padding:0 11px 0 10px; position:relative; text-align:center;}\r\n.smart-community__my-campus-network ul li:last-of-type{padding:0 10px;}\r\n.smart-community__my-campus-network ul li:after{display:block; content:\"\"; width:1px; height:35px; background:#e3e3e3; position:absolute; top:8px; right:0;}\r\n.smart-community__my-campus-network ul li:last-of-type:after{display:none;}\r\n.smart-community__my-campus-network ul li h3{height:22px; line-height:22px; font-size:12px; font-weight:normal; color:#9ea4a9; white-space:nowrap;}\r\n.smart-community__my-campus-network ul li p{height:25px; line-height:25px; font-family:Arial, Helvetica, sans-serif; font-size:18px;}\r\n/*待办提示*/\r\n.smart-community__tips{padding:20px 25px 0; text-align:center;}\r\n.smart-community__tips:after{display:block; content:\"\"; clear:both;}\r\n.smart-community__tips a:link,.smart-community__tips a:visited{display:block; width:calc(25% - 12px); height:100%; margin-right:12px; float:left; background-color:#eff9f3;border:1px solid #d9f1e3; -webkit-border-radius:12px; border-radius:12px; position:relative;}\r\n.smart-community__tips a:last-of-type{margin-right:0;}\r\n.smart-community__tips a img{}\r\n.smart-community__tips a p{width:100%; height:21px; line-height:21px; position:absolute; left:0; bottom:3px; font-size:14px;}\r\n.smart-community__tips a span{display:block; min-width:16px; height:22px; line-height:20px; padding:0 3px; text-align:center; font-size:12px; -webkit-border-radius:22px; border-radius:22px; position:absolute; right:6px; top:6px;}\r\n.smart-community__tips a:hover{background:#4fae76; color:#fff;}\r\n.smart-community__tips a:last-of-type span{right:-12px; top:-12px;}\r\n\r\n/*轮播图*/\r\n.smart-community__banner{width:70%; height:750px; position:absolute; right:0; top:0; z-index:0;}\r\n.smart-community__banner .swiper-slide{display:-webkit-box; display:-ms-flexbox; display:-webkit-flex; display:flex; -webkit-box-pack:center; -ms-flex-pack:center; -webkit-justify-content:center; justify-content:center; -webkit-box-align:center; -ms-flex-align:center; -webkit-align-items:center; align-items:center; background:#fff url(../../images/student/loading.gif) no-repeat center center;}\r\n.smart-community__banner .swiper-slide p{width:100%; height:750px; background-repeat:no-repeat; background-position:center center; background-size:cover;}\r\n\r\n\r\n/*服务模块组*/\r\n.smart-community__service-module-group{padding:163px 0 214px; height:988px; background:url(../../images/student/serviceBg.png) no-repeat center top; margin-top:-236px; position:relative; z-index:1;}\r\n.smart-community__service-module-group .w1260{position:relative;}\r\n.smart-community__service-module-group__left{margin-right:356px; height:588px;}\r\n\r\n/*新媒体（微信公众号等） */\r\n.new_media{height:390px;margin-top:40px;}\r\n.new_media_left{width:550px;height:390px;float:left;border-radius:12px; overflow:hidden;}\r\n.new_media_left .new_media_left_swiper_container{position:relative; z-index:0; height:390px;}\r\n.new_media_left .swiper-wrapper{width:100%;height:100%;}\r\n.new_media_left a.swiper-slide{display:block;width:100%;height:100%; background:#fff;}\r\n.new_media_left a.swiper-slide .swiper-slide-img{height:235px;background-size:cover; background-position:center center;margin-bottom:60px;}\r\n.new_media_left a.swiper-slide h3{line-height:36px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-left:12px;padding-right:12px;color:#333;font-size:15px;transition:all 0.4s;}\r\n.new_media_left a.swiper-slide h3 span{float:right;font-size:12px;font-weight:normal;color:#808080;margin-left:20px;}\r\n.new_media_left a.swiper-slide p{line-height:21px;color:#888;padding-left:12px;padding-right:12px;font-size:12px;}\r\n.new_media_left a.swiper-slide:hover h3{color:#4fae76;}\r\n\r\n.new_media_left_swiper_thumbs{width:550px;height:47px;border-top:1px solid #ccc;border-bottom:1px solid #ccc; overflow:hidden;position:absolute;top:235px;overflow:hidden;z-index:9;}\r\n.new_media_left_swiper_thumbs .swiper-slide{background-size:cover; background-position:center center;opacity:0.4; }\r\n.new_media_left_swiper_thumbs .swiper-slide-thumb-active{opacity:1;}\r\n\r\n.new_media_right{margin-left:568px;height:390px;}\r\n.new_media_right a{display:block;width:calc(50% - 14px);height:188px;border-radius:10px; position:relative;overflow:hidden;text-shadow:1px 1px 3px #000; margin:0 0 14px 14px; float:left;}\r\n.new_media_right a:after{display:block; width:100%; height:60px; content:\"\"; background:-webkit-linear-gradient(to bottom,rgba(0,0,0,0),rgba(0,0,0,0.5)); background:linear-gradient(to bottom,rgba(0,0,0,0),rgba(0,0,0,0.5)); position:absolute; left:0; bottom:0;}\r\n/*描边 text-shadow:#FFF 1px 0 0,#FFF 0 1px 0,#FFF -1px 0 0,#FFF 0 -1px 0;*/\r\n.new_media_right a p{height:100%;width:100%;background-size:cover; background-position:center center;transition:all 0.5s;}\r\n.new_media_right a:hover p{transform:scale(1.15);transition:all 0.5s;}\r\n.new_media_right a span{position:absolute;color:#fff;left:10px;bottom:30px; z-index:1;}\r\n.new_media_right a h4{width:100%;font-weight:normal;box-sizing:border-box;padding:0 10px;display:block;position:absolute;bottom:0;height:30px;line-height:30px; color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:all 0.4s; z-index:1;}\r\n.new_media_right a:hover:after{background:-webkit-linear-gradient(to bottom,rgba(79,174,119,0),rgba(79,174,119,0.8)); background:linear-gradient(to bottom,rgba(79,174,119,0),rgba(79,174,119,0.8));}\r\n.new_media_right a:hover h4{text-shadow:none;}\r\n\r\nimg.wxlogo{position:absolute;z-index:9999;top:6px;left:8px;}\r\n\r\n\r\n/*通知公告*/\r\n.smart-community__notice{height:102px; padding:20px 36px; -webkit-border-radius:12px; border-radius:12px; position:relative;}\r\n.smart-community__notice h2{width:40px; height:42px; line-height:21px; padding:10px 0; text-align:center; float:left; font-size:20px; font-weight:normal;} \r\n.smart-community__notice__con{height:102px; margin:0 100px 0 70px; overflow:hidden;}\r\n.smart-community__notice__con .swiper-slide{display:block; width:calc(100% - 12px); height:26px; line-height:26px; padding-left:12px; background:url(../../images/student/a01.png) no-repeat left center;}\r\n.smart-community__notice__con .swiper-slide span{float:right; color:#9ea4a9; padding-left:20px;}\r\n.smart-community__notice__more{width:70px; height:102px; text-align:right; position:absolute; right:36px; top:20px;}\r\n.smart-community__notice__more:before{display:block; width:1px; height:90px; background:#dbe6e7; position:absolute; left:0; top:6px; content:\"\";}\r\n.smart-community__notice__more a{display:inline-block; vertical-align:top; height:30px; line-height:17px; font-size:16px; text-align:center; letter-spacing:2px; padding:11px 0;}\r\n.smart-community__notice__more a span{display:block; height:13px; line-height:13px; font-size:12px; letter-spacing:0;}\r\n.smart-community__notice__more a:link, .smart-community__notice__more a:visited{color:#b8c2c9;}\r\n.smart-community__notice__more a:hover{color:#4fae76;}\r\n\r\n/*学生服务*/\r\n.smart-community__service{height:431px; margin-top:15px; -webkit-border-radius:12px; border-radius:12px; overflow:hidden; display:flex;}\r\n.smart-community__service__list{width:20%; height:481px; border-right:#ebebeb 1px solid; box-sizing:border-box; float:left; flex:1;}\r\n.smart-community__service__list:last-of-type{border-right:0;}\r\n.smart-community__service__list img{width:100%; height:154px; opacity:0.4;}\r\n.smart-community__service__list h2{height:24px; line-height:24px; padding:18px 20px 0; font-size:18px; font-weight:normal; color:#4fae76; overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}\r\n.smart-community__service__list ul{height:170px; padding:10px 20px 0;}\r\n.smart-community__service__list ul li{height:34px; line-height:34px; padding-left:10px; position:relative;}\r\n.smart-community__service__list ul li:before{display:block; width:4px; height:4px; background:#000; -webkit-border-radius:50%; border-radius:50%; position:absolute; left:0; top:15px; content:\"\"; -webkit-transition:all 0.3s; transition:all 0.3s;}\r\n.smart-community__service__list ul li a{display:inline-block; vertical-align:top; max-width:100%; height:34px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; position:relative;}\r\n.smart-community__service__list ul li a:link, .smart-community__service__list ul li a:visited{color:#333;}\r\n.smart-community__service__list p{height:30px; line-height:30px; padding:0 20px;}\r\n.smart-community__service__list p a{display:inline-block; vertical-align:top; height:30px; font-size:12px; text-transform:uppercase; position:relative;}\r\n.smart-community__service__list p a:link, .smart-community__service__list p a:visited{color:#b8c2c9;}\r\n.smart-community__service__list ul li a:before,\r\n.smart-community__service__list p a:before{display:block; content:\"\"; width:0; height:2px; background:#fff; -webkit-transition:all 0.3s; transition:all 0.3s; position:absolute; left:0; bottom:5px;}\r\n.smart-community__service__list:hover{background:#4fae76;}\r\n.smart-community__service__list:hover img{opacity:1;}\r\n.smart-community__service__list:hover h2,\r\n.smart-community__service__list:hover ul li a:link,\r\n.smart-community__service__list:hover ul li a:visited,\r\n.smart-community__service__list:hover p a:link,\r\n.smart-community__service__list:hover p a:visited{color:#fff;}\r\n.smart-community__service__list:hover ul li:before{background:#fff;}\r\n.smart-community__service__list:hover ul li a:hover:before, .smart-community__service__list:hover p a:hover:before{width:100%;}\r\n\r\n/*我的课表*/\r\n.smart-community__service-module-group__right{width:301px; height:550px; padding:18px 20px 20px; -webkit-border-radius:12px; border-radius:12px; position:absolute; top:0; right:0;}\r\n.my-curriculum__title{height:36px; position:relative; z-index:2;}\r\n.my-curriculum__title h2{height:28px; line-height:23px;padding-bottom:3px; font-size:18px; font-weight:normal;}\r\n.my-curriculum__title span{font-size:12px;color:#9ea4a9;}\r\n/*年度周次*/\r\n.my-curriculum__annual-weekly-times{width:108px; padding:1px 0; min-height:26px; border:#747474 1px solid; background:#fff; -webkit-border-radius:9px; border-radius:9px; position:absolute; right:0; top:-5px; cursor:pointer;z-index:999999;}\r\n.my-curriculum__annual-weekly-times:after{display:block; content:\"\\e8c9\"; font-family:\"iconfont\"; width:18px; height:13px; line-height:13px; text-align:center; font-size:16px; -webkit-transition:all 0.3s; transition:all 0.3s; position:absolute; right:16px; top:8px;}\r\n.my-curriculum__annual-weekly-times li{height:26px; line-height:26px; padding:0 30px 0 20px; display:none; position:relative; z-index:1;}\r\n.my-curriculum__annual-weekly-times li.my-curriculum__annual-weekly-times--current{display:block;}\r\n.my-curriculum__annual-weekly-times--show:after{transform:rotate(180deg); color:#4fae76;}\r\n.my-curriculum__annual-weekly-times--show li{display:block;}\r\n.my-curriculum__annual-weekly-times--show li.my-curriculum__annual-weekly-times--current{color:#4fae76;}\r\n/*每周*/\r\n.my-curriculum__weekly{height:56px; -webkit-border-radius:9px; border-radius:9px; background:#f9fbfc; overflow:hidden; position:relative; z-index:0; padding:12px 21px; margin-top:12px;}\r\n.my-curriculum__weekly ul{height:56px; overflow:hidden; position:relative; z-index:1;}\r\n.my-curriculum__weekly ul li{width:37px; height:36px; line-height:18px; float:left; text-align:center; -webkit-border-radius:37px; border-radius:37px; font-family:Arial, Helvetica, sans-serif; font-size:12px; padding:10px 0; cursor:pointer; -webkit-transition:all 0.3s; transition:all 0.3s; position:relative;}\r\n.my-curriculum__weekly ul li p{width:100%; height:36px; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%) scale(0.875);}\r\n.my-curriculum__weekly ul li p span{display:block; height:18px; line-height:18px;}\r\n.my-curriculum__weekly ul li:hover{color:#4fae76;}\r\n.my-curriculum__weekly ul li.my-curriculum__weekly--current{background:#4fae76; color:#fff; cursor:default;}\r\n.my-curriculum__weekly .my-curriculum__weekly__prev, .my-curriculum__weekly .my-curriculum__weekly__next{display:block; width:18px; height:18px; line-height:18px; position:absolute; top:50%; transform:translateY(-50%); z-index:0;}\r\n.my-curriculum__weekly .my-curriculum__weekly__prev{left:1px;}\r\n.my-curriculum__weekly .my-curriculum__weekly__next{right:1px;}\r\n\r\n/*课程列表*/\r\n.my-curriculum__list{height:420px; margin-top:2px;}\r\n.my-curriculum__list ul.curriculum-list{height:420px; overflow:auto;}\r\n.my-curriculum__list .curriculum-list li{display:block; padding:11px 0 12px; height:46px;border-bottom:#dbe6e7 1px solid;}\r\n.my-curriculum__list .curriculum-list li h3{height:25px; line-height:25px; font-size:16px; font-weight:normal;}\r\n.my-curriculum__list .curriculum-list li p{height:21px; line-height:21px; color:#9ea4a9; overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}\r\n.my-curriculum__list .curriculum-list li p i{color:#4ca771; display:inline-block; vertical-align:top; height:21px;}\r\n.my-curriculum__list .curriculum-list li p span{padding-left:20px;}\r\n.my-curriculum__list .curriculum-list li p span i{padding-right:2px;}\r\n\r\n.my-curriculum__list ul.curriculum-list::-webkit-scrollbar{width:6px; height:6px;}\r\n.my-curriculum__list ul.curriculum-list::-webkit-scrollbar-track{background-color:transparent;}\r\n.my-curriculum__list ul.curriculum-list::-webkit-scrollbar-thumb{-webkit-border-radius:6px; border-radius:6px; background-color:#a3a6aa;}\r\n.my-curriculum__list ul.curriculum-list::-webkit-scrollbar-thumb:hover{background-color:#8c8e91;}\r\n\r\n\r\n\r\n/*新闻板块*/\r\n.smart-community__news{height:842px; background:url(../../images/student/newsBg.png) no-repeat center center; position:relative; z-index:0; margin-top:-267px; padding-top:256px;}\r\n\r\n/*新闻banner*/\r\n.smart-community__news-banner{width:714px; height:650px; position:relative; z-index:0; float:left;}\r\n.smart-community__news-banner .news-banner__pic1{width:341px; height:383px; position:absolute; left:-151px; top:-36px; z-index:2;}\r\n.smart-community__news-banner .news-banner__pic2{width:617px; height:391px; position:absolute; right:-1px; bottom:-137px; z-index:2;}\r\n.smart-community__news-banner .news-banner{width:714px; height:650px; overflow:hidden; -webkit-border-radius:150% 130% 140% 100%; border-radius:150% 130% 140% 100%; position:absolute; left:-68px; top:0;}\r\n.smart-community__news-banner .news-banner .swiper-slide{display:-webkit-box; display:-ms-flexbox; display:-webkit-flex; display:flex; -webkit-box-pack:center; -ms-flex-pack:center; -webkit-justify-content:center; justify-content:center; -webkit-box-align:center; -ms-flex-align:center; -webkit-align-items:center; align-items:center; background:#fff url(../../images/student/loading.gif) no-repeat center center;}\r\n.smart-community__news-banner .news-banner .swiper-slide p{width:100%; height:650px; background-repeat:no-repeat; background-position:center center; background-size:cover;}\r\n\r\n/*新闻tab*/\r\n.smart-community__news-tab{height:490px; margin-left:768px; padding-top:96px; position:relative; z-index:1;}\r\n.news-tab{height:490px;}\r\n.news-tab .my-pagination{height:40px; line-height:40px; font-size:0; display:flex;}\r\n.news-tab .my-pagination .swiper-pagination-bullet{display:inline-block; vertical-align:top; background:#fff; -webkit-border-radius:30px; border-radius:30px; width:auto; height:40px; line-height:40px; padding:0; font-size:20px; margin:0 10px 0 0; opacity:1; text-align:center; flex:1;}\r\n.news-tab .my-pagination .swiper-pagination-bullet:last-of-type{margin-right:0;}\r\n.news-tab .my-pagination .swiper-pagination-bullet-active{color:#fff;background-image:linear-gradient(to bottom right,#25c1b6,#39f59e);}\r\n.news-tab .swiper-wrapper{height:426px; margin-top:24px;}\r\n.news-tab .swiper-slide{display:block; background:#f4f7ff;}\r\n.news-tab .swiper-slide ul{height:348px;}\r\n.news-tab .swiper-slide ul li{height:57px; line-height:57px; border-bottom:#d9dee9 1px solid;overflow:hidden;white-space:nowrap;text-overflow:ellipsis; font-size:16px;}\r\n.news-tab .swiper-slide ul li span{float:right; color:#9ea4a9; padding-left:20px;}\r\n.news-tab .swiper-slide p{padding-top:30px; height:48px; line-height:48px; font-size:16px;}\r\n.news-tab .swiper-button{width:108px; height:48px; position:absolute; right:0; bottom:0;}\r\n.news-tab .swiper-button .swiper-button-prev, .news-tab .swiper-button .swiper-button-next{width:48px; height:48px; line-height:48px; text-align:center; -webkit-border-radius:50%; border-radius:50%; -webkit-transition:all 0.3s; transition:all 0.3s; color:#696969; margin-top:0; top:0;}\r\n.news-tab .swiper-button .iconfont{font-size:20px;}\r\n.news-tab .swiper-button .swiper-button-prev{left:0;}\r\n.news-tab .swiper-button .swiper-button-next{right:0;}\r\n.news-tab .swiper-button .swiper-button-prev:after, .news-tab .swiper-button .swiper-button-next:after{display:none;}\r\n.news-tab .swiper-button .swiper-button-prev:hover, .news-tab .swiper-button .swiper-button-next:hover{background:#4fae76; color:#fff;}\r\n\r\n\r\n/* 页底 */\r\n.smart-community__foot{padding-top:56px; height:172px; position:relative; z-index:3; background:url(../../images/student/footBg.png) no-repeat center bottom;}\r\n.smart-community__foot .w1260{position:relative; z-index:1;}\r\n.smart-community__foot .ewm{width:496px; height:172px; float:right; position:relative;}\r\n/*.smart-community__foot .ewm:after{display:block; content:\"\"; width:224px; height:234px; background:url(../../images/student/footPic.png) no-repeat center bottom; position:absolute; right:34px; bottom:0;}*/\r\n.smart-community__foot .ewm p{float:left; width:130px; height:102px; padding-left:20px;padding-right:10px; text-align:center;}\r\n.smart-community__foot .ewm p img{width:130px; height:130px;}\r\n.smart-community__foot .ewm p span{display:block; height:16px; line-height:16px; font-size:12px; color:#9ea4a9;}\r\n.smart-community__foot .contact{height:80px; line-height:20px; margin-right:516px; padding:46px 0 46px 278px; background:url(../../images/student/fLogo.png) no-repeat left center; font-size:12px; color:#9ea4a9;}\r\n.smart-community__foot .contact a:link, .smart-community__foot .contact a:visited{color:#9ea4a9;}\r\n.smart-community__foot .contact a:hover{color:#4fae76;}\r\n.smart-community__foot .contact a img{height:18px; vertical-align:text-bottom; padding-right:3px;}\r\n.smart-community__foot .contact span{padding-left:1em;}\r\n\r\n\r\n/*校园生活弹出层*/\r\n.smart-community__campus-life{margin:0 -10px;padding-bottom:20px;}\r\n.smart-community__campus-life ul:after{display:block; content:\"\"; clear:both;}\r\n.smart-community__campus-life ul li{width:calc(20% - 20px); height:32px; line-height:32px; padding:0 10px; float:left; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;}\r\n.smart-community__campus-life ul li i{padding-right:5px; color:#a9afb3; font-size:14px;}\r\n.smart-community__campus-life ul li a:hover i{color:#4fae76;}\r\n\r\n\r\n/*二级页面banner*/\r\n.smart-community__ny-head{height:638px; position:relative; overflow:hidden;}\r\n.smart-community__ny-head__con{height:638px; position:relative; z-index:1;background:url(../../images/student/nyHeadBg.png) no-repeat center top;}\r\n.smart-community__page-title{margin-top:60px; height:75px; line-height:75px; font-size:50px; position:relative; z-index:2;}\r\n.smart-community__ny-banner{width:70%; height:500px; position:absolute; right:0; top:0; z-index:0; background-repeat:no-repeat; background-position:center right; background-size:cover;}\r\n\r\n\r\n.smart-community__ny{margin:-196px auto 50px; position:relative; z-index:1;}\r\n.smart-community__ny-left{width:240px; float:left;}\r\n.smart-community__ny-left ul{border-top:#dbe6e7 1px solid;}\r\n.smart-community__ny-left ul li a{display:block; line-height:24px; padding:10px 28px 10px 20px; border:#dbe6e7 1px solid; border-top:0; font-size:16px; position:relative;}\r\n.smart-community__ny-left ul li a:after{display:block; content:\"\\e637\"; font-family:\"iconfont\"; position:absolute; top:50%; right:20px; transform:translateY(-50%); z-index:10; height:24px; color:#9ea4a9; -webkit-transition:all 0.3s; transition:all 0.3s;}\r\n.smart-community__ny-left ul li a:hover,\r\n.smart-community__ny-left ul li a:hover:after{color:#4fae76;}\r\n.smart-community__ny-left ul li a.on{background:#4fae76; color:#fff;}\r\n.smart-community__ny-left ul li a.on:after{color:#fff;}\r\n\r\n\r\n.smart-community__ny-right{margin-left:280px;}\r\n.smart-community__ny-right:after{display:block; content:\"\"; clear:both;}\r\n.smart-community__ny-post{height:38px; line-height:38px; font-size:14px; color:#9ea4a9; border-bottom:1px solid #e3e3e3; padding-top:6px;}\r\n.smart-community__ny-post span{float:right; line-height:26px; padding-top:12px;}\r\n.smart-community__ny-post span a:link, .smart-community__ny-post span a:visited{color:#999;}\r\n.smart-community__ny-post span a:hover{color:#4fae76;}\r\n.smart-community__ny-post h3{float:left; color:#4fae76; border-bottom:2px solid #4fae76; font-size:20px; font-weight:normal;}\r\n\r\n\r\n.smart-community__ny-list01{padding-top:10px;}\r\n.smart-community__ny-list01 li{height:41px; line-height:41px; border-bottom:#e3e3e3 1px dashed; padding-left:12px; background:url(../../images/student/a01.png) no-repeat left center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}\r\n.smart-community__ny-list01 li span{float:right; padding-left:20px; color:#9ea4a9;}\r\n\r\n\r\n.smart-community__ny-articleTitle{padding:40px 0 20px; line-height:30px; font-size:24px; font-weight:600; text-align:center;}\r\n.smart-community__ny-articleInfo{width:96%; height:36px; line-height:36px; background:#f5f5f5; color:#666; text-align:center; margin:0 auto;}\r\n.smart-community__ny-articleInfo label{padding-left:30px;}\r\n.smart-community__ny-articleCon{line-height:36px; padding:20px 0 30px; font-size:16px; text-justify:inter-ideograph; text-align:justify;}\r\n.smart-community__ny-article img{max-width:900px; height:auto !important; margin:0 auto;_width:expression(document.body.clientWidth > 900 ? \"900px\" :\"auto\"); vertical-align:top;}\r\n.smart-community__ny-article2 img{max-width:1200px; _width:expression(document.body.clientWidth > 1200 ? \"1200px\" :\"auto\");}\r\n.smart-community__ny-article2 .articleCon{padding:20px 0;}\r\n.smart-community__ny-article2 .articleTitle{padding:40px 150px 20px;}\r\n.smart-community__ny-articleCon table{margin:0 auto;}\r\n\r\n.smart-community__ny-page01{text-align:center; padding:20px 30px 30px; line-height:30px;}\r\n\r\n\r\n.smart-community__ny-sub-title{height:42px; line-height:42px; padding-top:12px;}\r\n.smart-community__ny-sub-title h2{height:42px; font-size:24px; font-weight:normal;}\r\n.smart-community__ny-sub-title .line-btn{float:right; height:42px; line-height:42px; -webkit-border-radius:14px; border-radius:14px; padding:0 36px;}\r\n\r\n.smart-community__table-box{padding-top:40px;}\r\n.smart-community__data-table{width:100%; font-size:16px;}\r\n.smart-community__data-table td{border:#f4f4f4 1px solid; line-height:24px; padding:15px;}\r\n.smart-community__data-table td.headTd{color:#7d7d7d; text-align:center;}\r\n\r\n\r\n.smart-community__my-do{padding-top:40px;}\r\n.my-do__btn-list{padding-top:24px; height:42px;}\r\n.my-do__btn-list .line-btn{margin-right:20px; border-color:#c1c1c1; -webkit-border-radius:0; border-radius:0; padding:0 48px; height:50px; line-height:50px;}\r\n\r\n\r\n\r\n.robot{position:fixed;top:20%;right:-210px;z-index:9;}\r\n.robot img{height:200px;cursor:pointer;}\r\n.robot-tip{border-top-left-radius:16px;border-bottom-left-radius:16px; background-color:#FFF; overflow:hidden; }\r\n.robot-tip-header{height:38px;line-height:38px;background-color:#eb9a66; text-align:center; font-weight:normal;color:#FFF; font-size:16px;letter-spacing:1px;border-bottom:1px solid #e1e1e1;}\r\n.robot-tip ul{margin-left:16px;}\r\n.robot-tip ul li{line-height:30px;font-size:15px; list-style-type:circle;color:#FFF;}\r\n.robot-tip ul li label{color:#eaff00;margin-right:6px;}\r\n.box-shadow2{-moz-box-shadow:1px 1px 20px rgba(0,0,0,.19);-webkit-box-shadow:1px 1px 20px rgba(0,0,0,.19);box-shadow:1px 1px 20px rgba(0,0,0,.19);top:20px;left:20px;}\r\n\r\n.robot-tip-content{width:200px;padding:10px 10px 20px 20px;background-color:#3acc76;}\r\n.robot-tip-search-box{margin-top:10px; border:1px solid #FFF; height:30px;border-radius:20px;background-color:#FFF;padding-left:16px;opacity:1;}\r\n.robot-tip-search-box .keyword{width:146px; height:30px; line-height:30px; font-size:14px; background:none; border:0; padding:0; margin:0; float:left;}\r\n.robot-tip-search-box .search-btn{width:32px; height:30px; line-height:30px; text-align:center; font-size:18px; border:0; background:none; padding:0; margin:0; cursor:pointer; float:left; color:#9ea4a9;}\r\n.robot-tip-search-box .search-btn:hover{color:#4fae76;}\r\n\r\n/*微信公众号列表页*/\r\n.wx_list_header{padding-top:50px;}\r\n.wx_list_header h3{font-size:16px;width:1030px;min-height:36px;zoom:1;color:#FFF; font-weight:normal;}\r\n.wx_list_header h3 a:link,.wx_list_header h3 a:visited{color:#FFF;height:36px;line-height:36px;padding:0 20px;display:block; margin-bottom:10px; float:left;margin-right:10px;border-radius:30px;border:0;letter-spacing:1px;background-color:#9ea4a9;}\r\n.wx_list_header h3 a:first-child:link,.wx_list_header h3 a:first-child:visited{padding-left:42px;background:#9ea4a9 url(../../images/student/wxlogo.png) 12px center no-repeat;background-size:20px;}\r\n.wx_list_header h3 a:hover{cursor:pointer;background-color:#4ca771 !important;}\r\n.wx_list_header h3 a.current{background-color:#4ca771!important;}\r\n.wx_list_header hr{clear:both;border:0;border-bottom:1px solid #f1f1f1;height:0;}\r\n\r\n.wx_list_header .wx_list_search{float:right;height:34px;line-height:34px;width:200px;padding:0 6px 0 18px;border:1px solid #ccc;border-radius:30px; overflow:hidden;}\r\n.wx_list_header .wx_list_search input{width:160px;height:34px;float:left;border:0;}\r\n.wx_list_header .wx_list_search input::placeholder{color:#999;}\r\n.wx_list_header .wx_list_search button{width:34px;height:34px;margin-left:6px;font-size:18px;border:0;cursor:pointer;background-color:#FFF;}\r\n.wx_list_header .wx_list_search button:hover{color:#ff7b26;}\r\n\r\n.wx_list_items,.wx_list_items_thumb{clear:both;margin-top:26px;}\r\n.wx_list_items_thumb li{float:left;width:404px;height:230px;margin-bottom:26px;margin-right:24px;border-radius:6px; overflow:hidden; position:relative;}\r\n.wx_list_items_thumb li:nth-child(3n){margin-right:0;}\r\n.wx_list_items_thumb a:link,.wx_list_items_thumb a:visited{display:block;width:100%; height:100%;color:#fff;}\r\n.wx_list_items_thumb a:hover{color:#ffff00;}\r\n.wx_list_items_thumb a::after{display:block; width:404px; height:80px; position:absolute;bottom:0; z-index:10;content:\"\"; background:-webkit-linear-gradient(to bottom,rgba(0,0,0,0),rgba(0,0,0,0.5)); background:linear-gradient(to bottom,rgba(0,0,0,0),rgba(0,0,0,0.3)); left:0; bottom:0;}\r\n.wx_list_items_thumb a p{width:100%;height:100%;background-size:cover; background-position:center center;transition:all 0.5s;}\r\n.wx_list_items_thumb a:hover p{transform:scale(1.1);transition:all 0.5s;}\r\n.wx_list_items_thumb a label{position:absolute;z-index:20;left:16px;bottom:30px;}\r\n.wx_list_items_thumb a h4{width:100%;height:30px; line-height:30px; position:absolute;bottom:0;left:0;z-index:20;padding:0 16px;box-sizing:border-box;font-weight:normal;transition:all 0.4s;}\r\n.wx_list_items_thumb a span{display:none;}\r\n\r\n.wx_list_items li{height:100px;margin-bottom:26px;}\r\n.wx_list_items p{width:180px;height:100px;float:left;margin-right:12px;border-radius:5px; overflow:hidden;background-size:cover; background-position:center center;}\r\n.wx_list_items h4{font-size:16px;font-weight:normal;margin-bottom:10px;}\r\n.wx_list_items span{margin-bottom:10px;color:#888;font-size:14px;max-height:42px; line-height:21px;}\r\n\r\n.wx_list_items label{font-size:14px;}\r\n\r\n.wx_list_top{height:43px; line-height:43px;margin-top:12px;}\r\n.wx_list_view_switch{float:right;}\r\n.wx_list_view_switch i{font-size:23px;color:#9ea4a9;cursor:pointer;margin-left:12px;}\r\n.wx_list_view_switch i.current{color:#ff7b26}\r\n.wx_list_view_switch i:hover{color:#ff7b26}\r\n.wx_list_seacrh_result{font-size:18px;color:#555;}\r\n.wx_list_seacrh_result label{color:#f00}\r\n\r\n\r\n@media screen and (max-width:1300px){\r\n\t.container{min-width:100%; _width:100%;}\r\n\t.w1260{width:calc(100% - 30px); padding:0 15px;}\r\n\t\r\n\t.smart-community__logo{padding:56px 15px; background-position:15px center;}\r\n\t\r\n\t.smart-community__service__list h2{font-size:16px;}\r\n\t.smart-community__service-module-group__right{right:15px;}\r\n\t\r\n\t.news-tab .my-pagination .swiper-pagination-bullet{font-size:16px; margin-right:5px;}\r\n}\r\n\r\n\r\n/* 20240220新增 */\r\n/* title提示框 */\r\n.btn{cursor:pointer;}\r\n.tooltip{font-size:12px; line-height:1.5; position:absolute; z-index:100003;}\r\n.tipsy-arrow{position:absolute; width:0; height:0; line-height:0; border:6px dashed #4fae76; top:0; left:20%; margin-left:-5px; border-bottom-style:solid; border-top:0; border-left-color:transparent; border-right-color:transparent; display:none;}\r\n.tipsy-arrow-n{border-bottom-color:#4fae76;}\r\n.tipsy-inner{background-color:#ff7b26; color:#fff; max-width:200px; padding:5px 8px 4px; text-align:center; border-radius:3px; box-shadow:0 2px 1px rgba(0,0,0,0.2);}\r\n\r\n/*修改手机号码弹出层*/\r\n.smart-community__student-tel{margin:0 5px; padding-bottom:10px;}\r\n.smart-community__student-tel ul li{height:32px; line-height:32px; padding:5px 0; display:flex; flex-direction:row; align-items:center; justify-content:center;}\r\n.smart-community__student-tel ul li label{display:block; width:100px; height:32px; text-align:right; color:#666;}\r\n.smart-community__student-tel ul li p{height:32px; margin-right:40px; flex:1; display:flex; flex-direction:row; align-items:center; justify-content:flex-start;}\r\n.smart-community__student-tel ul li .txt{height:30px; line-height:30px; padding:0 4px; border:#e6e6e6 1px solid; flex:1; border-radius:3px;}\r\n.smart-community__student-tel ul li .txt:disabled{background:#f9f9f9;}\r\n.smart-community__student-tel ul li .verification-code__p{display:flex; flex-direction:row; align-items:center; justify-content:center;}\r\n.smart-community__student-tel ul li .verification-code__p .btn{width:160px; height:32px; line-height:32px; font-size:14px; background:#4fae76; color:#fff; text-align:center; border:0; margin-left:10px; border-radius:3px;}\r\n.smart-community__student-tel ul li .verification-code__p .btn.disabled{background:#aaa; cursor:no-drop;}\r\n\r\n\r\n/* 20240422新增 */\r\n/*人脸识别失败提示*/\r\n.faceMsg{position:absolute; z-index:101; background:rgba(243,157,34,0.8); -webkit-border-radius:10px; border-radius:10px; box-shadow:2px 3px 6px rgba(77,45,0,0.3); padding:10px 15px; line-height:20px; color:#fff; font-size:16px;display:none;}\r\n.faceMsg:before{display:block; content:\"\"; width:37px; height:29px; background:url(../../images/faceMsgBg.png) no-repeat left top; position:absolute; left:20px; bottom:-29px; opacity:0.8;}"
