            "mimeType": "application/json; charset=UTF-8",
            "size": 7585,
            "text": "{\n  \"code\" : 200,\n  \"message\" : \"OK\",\n  \"data\" : {\n    \"multi-industry-key-word\" : {\n      \"load_feature_word_en\" : {\n        \"standard\" : \"标准\",\n        \"college\" : \"\",\n        \"errorCode-XGH\" : \"The student or employee ID\",\n        \"inner-face-recognition\" : \"人脸识别\",\n        \"on-position\" : \"在职\",\n        \"teach-building\" : \"\",\n        \"agree-photo-authentic-1\" : \"收集我的人脸影像用于验证个人身份\",\n        \"mobile-uniqueness-administrator\" : \"The current cell phone number conflicts with other user names, and the school has opened the cell phone number as a login user name. To guarantee unique user name, contact the administrator\",\n        \"dept-class\" : \"部门\",\n        \"work-number\" : \"Student ID number\",\n        \"inner-relatives\" : \"校内亲属\",\n        \"office\" : \"部门\",\n        \"teacher-ls\" : \"\",\n        \"stop-school\" : \"\",\n        \"major\" : \"\",\n        \"end-school\" : \"辞退\",\n        \"graduate\" : \"\",\n        \"GH-and-XH\" : \"账号\",\n        \"XH-or-GH-1\" : \"Student number or job number\",\n        \"inner-student\" : \"在校学生\",\n        \"XH-or-GH-2\" : \"student/employee ID\",\n        \"errorCode-inner-network\" : \"The campus network\",\n        \"school-name\" : \"\",\n        \"XH-or-GH-3\" : \"student ID or employee ID\",\n        \"school-area\" : \"\",\n        \"all\" : \"\",\n        \"org-example\" : \"\",\n        \"start-school\" : \"入职\",\n        \"package\" : \"套餐\",\n        \"inner-face\" : \"人脸\",\n        \"campus\" : \"\",\n        \"agree-photo-authentic\" : \"同意本校收集我的人脸影像用于验证个人身份\",\n        \"XH-GH\" : \"student number/job number\",\n        \"5g-network-service\" : \"校园网5G专网业务服务\",\n        \"outer-network-2\" : \"校外网\",\n        \"outer-network-1\" : \"校外网\",\n        \"JGH\" : \"账号\",\n        \"classroom\" : \"\",\n        \"XH-or-GH\" : \"账号\",\n        \"inner-identity\" : \"身份\",\n        \"inner\" : \"在职\",\n        \"group-introduce\" : \"当只需要将在校状态的学生按照当前的组织结构层级关系推送到企业微信中时，将学生的组织结构作为群组节点关联到群组视图内部，并在群组节点上设定匹配的学生状态是在校，即可在不影响数据重新调整的情况下向外提供有效的数据了。\",\n        \"shcool-establishment\" : \"校设\",\n        \"organizational-structure\" : \"组织架构\",\n        \"campus-area\" : \"\",\n        \"inner-facing\" : \"刷脸\",\n        \"new-person\" : \"New student\",\n        \"JXRY\" : \"\",\n        \"XGH\" : \"账号\",\n        \"plac-ids\" : \"student ID or employee ID\",\n        \"identity-status-inner\" : \"在校\",\n        \"inner-contact\" : \"通讯录\",\n        \"inner-life\" : \"生活\",\n        \"student\" : \"\",\n        \"university\" : \"\",\n        \"dormitory\" : \"\",\n        \"enter-school\" : \"入职\",\n        \"teacher-js\" : \"\",\n        \"industry\" : \"行业标准\",\n        \"student-and-work-num\" : \"Student number or job number\",\n        \"agree-own-photo-to-face\" : \"同意将我的人脸影像提供给校内人脸应用使用\",\n        \"out-school\" : \"离职\",\n        \"IDcard\" : \"\",\n        \"identity\" : \"身份\",\n        \"identity-status-out\" : \"离校\",\n        \"BZ\" : \"\",\n        \"FDY\" : \"\",\n        \"go-in-reason\" : \"入校理由\",\n        \"department\" : \"\",\n        \"class\" : \"\",\n        \"owner\" : \"\",\n        \"GH\" : \"账号\",\n        \"XH\" : \"账号\",\n        \"5g-school-name\" : \"学校名称\",\n        \"high-education\" : \"\",\n        \"5g-network-apply\" : \"5G校园专网业务申办须知\",\n        \"JZG\" : \"员工\",\n        \"inner-network\" : \"内网\",\n        \"XS-and-JGZ\" : \"，如学生和教职工\",\n        \"BZR\" : \"\",\n        \"scholar-id\" : \"用户ID\",\n        \"wechat-notice-first\" : \"Your campus ID account will be connected when you first log in\",\n        \"undergraduate\" : \"\",\n        \"login-namePlaceholder\" : \"student/employee\"\n      },\n      \"load_feature_word_zh\" : {\n        \"standard\" : \"校标\",\n        \"college\" : \"学院\",\n        \"errorCode-XGH\" : \"学工号\",\n        \"inner-face-recognition\" : \"校园人脸识别\",\n        \"on-position\" : \"在校\",\n        \"teach-building\" : \"教学楼\",\n      