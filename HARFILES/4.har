CEL\": \"用户手动取消了请求的行为\",\n  \"ERROR_REQUEST_CONVERT\": \"解析服务端返回的请求参数错误\",\n  \"ERROR_REQUEST_PARAMETER\": \"Fido2Sdk 请求的函数参数错误\",\n  \"ERROR_RESPONSE_FIDO2\": \"系统 Fido2 组件返回错误 \",\n  \"ERROR_RESPONSE_PARSE\": \"解析系统 Fido2 组件返回参数错误 \",\n  \"REPEAT_REGISTRATION\": \"已经注册 \",\n  \"NOT_REGISTERED\": \"还未注册\",\n  \"NOT_REGISTRY+PASSKEY\": \"此设备还没有创建通行密钥\",\n  \"otp_input_placeholder\": \"请输入动态口令\",\n  \"how_to_create_passkeys\": \"如何创建通行密钥？\",\n  \"passkeyUseModal.content1\": \"1.通过账密或其他登录方式进行登录，进入个人中心\",\n  \"passkeyUseModal.content2\": \"2.在【个人中心 > 安全中心】找到「通行密钥」，点击进入\",\n  \"passkeyUseModal.content3\": \"3.进入通行密钥管理列表后，点击「创建通行密钥」完成创建\",\n  \"start_login\": \"开始登录\",\n  \"go_safe_center\": \"进入安全中心\",\n  \"create_passkeys\": \"创建通行密钥\",\n  \"last_step\": \"上一步\",\n  \"complete\": \"完成\",\n  \"passkey_advantage\": \"有了通行密钥，你将不再需要记住复杂的密码，密码将用你的指纹、人脸等其他方式代替，完成一键登录。\",\n  \"please_click\": \"了解如何创建通行密钥，请点击\",\n  \"no_passkeys\": \"您还没有创建通行密钥\",\n  \"konw\": \"知道了\",\n  \"account_risk\": \"您的账号存在风险，请重新认证\",\n  \"new_guide_tip\": \"在此处【切换】登录方式\",\n  \"new_guide_tip1\": \"借助通行密钥，不需要记住密码！\",\n  \"new_guide_tip2\": \"仅凭指纹、面孔、屏幕解锁方式或安全密钥即可安全登录\",\n  \"delegate_number\": \"你当前收到{{ delegateNum }}条委托事项，被授予登录委托人账号的权限\",\n  \"delegate_account\": \"委托人账号\",\n  \"my_account\": \"自己账号\",\n  \"help_to_manage_things\": \"帮委托人管理事项\",\n  \"delegation\": \"委托\",\n  \"delegate_account_number\": \"委托账号\",\n  \"ower_account_number\": \"个人账号\",\n  \"some_sensitive_data\": \"委托的应用存在少量敏感数据\",\n  \"trustee_will_operate_within_the_scope\": \"受托人将在委托人给予的权限范围内进行操作，避免后续产生个人纠纷及相关法律问题；\",\n  \"all_access_actions_will_recored\": \"受托人所有访问行为都将被系统记录。\",\n  \"activate_new\": \"激活新口令\",\n  \"click_here\": \"点我获取\",\n  \"before_activation\": \"新口令需验证后激活，点击按钮开始激活\",\n  \"search_for\": \"请通过 微信搜索 {{ name }} 扫码绑定\",\n  \"to_input\": \"去输入口令\",\n  \"return_to\": \"返回输入口令\",\n  \"password_expired\": \"口令已失效？点我\",\n  \"reacquire\": \"重新获取动态口令\",\n  \"QR_code\": \"请通过 {{ name }} 扫码绑定\",\n  \"save_screenshot\": \"截图保存