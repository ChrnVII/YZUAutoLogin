"http://jwtsg.yzu.edu.cn\",\"appName\":\"敬文图书馆座位预约系统\"},{\"ID\":37,\"appUrl\":\"http://tzb.yzu.edu.cn\",\"appName\":\"挑战杯校赛作品申报系统\"},{\"ID\":31,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/XYXFSB/start\",\"appName\":\"校园先锋申报\"},{\"ID\":32,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/SHSJHDYXXMSB/start\",\"appName\":\"社会实践活动优秀项目申报\"},{\"ID\":30,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/HLTZBSB/start\",\"appName\":\"五四表彰申报\"},{\"ID\":28,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/YZSYSQ/start\",\"appName\":\"就业用章申请\"},{\"ID\":34,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/XSSTZCDJ/start\",\"appName\":\"学生社团注册登记申请\"},{\"ID\":29,\"appUrl\":\"https://mcwk.mycourse.cn/theme/sj.html\",\"appName\":\"安全微伴\"},{\"ID\":36,\"appUrl\":\"https//ehall.yzu.edu.cn/infoplus/form/STDJSXBG/start\",\"appName\":\"学生社团登记事项变更申请\"},{\"ID\":33,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/XSSTHBSQ/start\",\"appName\":\"学生社团合并申请\"},{\"ID\":35,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/XSSTZXDJ/start\",\"appName\":\"学生社团注销登记申请\"}];\r\n        appArr[3] = [{\"ID\":42,\"appUrl\":\"http://xxhc.yzu.edu.cn/zbrj/\",\"appName\":\"正版化软件下载\"},{\"ID\":39,\"appUrl\":\"http://jsxszz.jse.edu.cn/pros_jszz/s/wxbiz/getZzZc\",\"appName\":\"困难生认定\"},{\"ID\":38,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/XSLFXTZD/start\",\"appName\":\"学生离（返）校通知单\"},{\"ID\":40,\"appUrl\":\"http://eb.yzu.edu.cn/medicare/index\",\"appName\":\"医保报销指南\"},{\"ID\":41,\"appUrl\":\"https://newgis.yzu.edu.cn/map?w=3380&u=52a14fcf705d4365b283950c64e8ad5e\",\"appName\":\"校园地图\"},{\"ID\":43,\"appUrl\":\"http://email.yzu.edu.cn/\",\"appName\":\"邮箱系统（学生）\"},{\"ID\":44,\"appUrl\":\"http://o365.yzu.edu.cn\",\"appName\":\"OneDrive云盘\"},{\"ID\":59,\"appUrl\":\"https://ehall.yzu.edu.cn/infoplus/form/GHWWSP/start\",\"appName\":\"工会慰问申请\"}];\r\n        appArr[4] = [{\"ID\":55,\"appUrl\":\"https://cet.neea.edu.cn/\",\"appName\":\"全国英语四六级考试\"},{\"ID\":58,\"appUrl\":\"http://bm.cltt.org/#/index\",\"appName\":\"国家普通话水平测试在线报名系统\"},{\"ID\":46,\"appUrl\":\"https://kyfw.12306.cn/otn/leftTicket/init\",\"appName\":\"火车时刻表\"},{\"ID\":47,\"appUrl\":\"https://yangzhou.8684.cn/\",\"appName\":\"扬州公交查询\"},{\"ID\":45,\"appUrl\":\"http://www.caac.gov.cn/index.html\",\"appName\":\"机票查询\"},{\"ID\":56,\"appUrl\":\"https://ncre.neea.edu.cn/\",\"appName\":\"全国计算机等级考试\"},{\"ID\":57,\"appUrl\":\"https://ntce.neea.edu.cn/\",\"appName\":\"全国中小学教师资格考试\"},{\"ID\":53,\"appUrl\":\"https://www.chsi.com.cn/xlrz/index.jsp\",\"appName\":\"学历证书查询\"},{\"ID\":52,\"appUrl\":\"http://yz.jszwfw.gov.cn/col/col168722/index.html\",\"appName\":\"违章查询\"},{\"ID\":50,\"appUrl\":\"http://jshrss.jiangsu.gov.cn/col/col74421/index.html\",\"appName\":\"社保\"},{\"ID\":54,\"appUrl\":\"https://www.kuaidi100.com/\",\"appName\":\"快递查询\"},{\"ID\":51,\"appUrl\":\"http://58.220.193.178/hfmis_wt/login\",\"appName\":\"公积金\"},{\"ID\":48,\"appUrl\":\"https://weather.cma.cn/web/weather/58245.html\",\"appName\":\"天气查询\"},{\"ID\":49,\"appUrl\":\"http://m.yz.bendibao.com/news/gelizhengce/all.php?src=baidu&leavecity=yz\",\"appName\":\"出行疫情政策查询\"}];\r\n\r\n        page.showMoreApp = function (index) {//应用顺序，index从1开始\r\n            index = index - 1;\r\n            var title = appKindArr[index];\r\n            var conDiv = $(\"#smart-community__campus-life\");\r\n            var ul = conDiv.find(\"ul:first\");\r\n            ul.empty();\r\n            for(var i=0;i<appArr[index].length;i++){\r\n                var p = appArr[index][i];\r\n                ul.append(\"<li><a data-id='\"+p.ID+\"' href='\"+p.appUrl+\"' target='_blank' title='\"+p.appName+\"'><i class='iconfont icon-you animate'></i>\"+p.appName+\"</a></li>\");\r\n            }\r\n            var iLayer = layer.open({\r\n                type: 1,\r\n                title: title,\r\n                skin: \"layerBox\", //自定义弹出层样式，alert层需同时加载“layerAlert”\r\n                area: \"1000px\",\r\n                content: conDiv, //这里content是一个DOM，注意：最好该元素要存放在body最外层，否则可能被其它的相对元素所影响\r\n                isOutAnim: false, //关闭层的动画按钮\r\n                resize: false,\r\n                zIndex: 999\r\n            });\r\n        }\r\n\r\n        $().ready(function () {\r\n\r\n\r\n            $(\"#mySchoolNet\").css({ \"cursor\": \"pointer\" }).click(function () {\r\n                window.open('http://zzfw.yzu.edu.cn')\r\n            });\r\n\r\n            $(\"ul.app_list\").delegate(\"a\",\"click\",function(){\r\n                var data = {\r\n                    \"__RequestVerificationToken\": page.token,\r\n                    \"ID\" : ConvertToInt($(this).attr(\"data-id\"))\r\n                }\r\n                $.post(\"/Student/Home/AddClickCount\",data);\r\n            });\r\n\r\n\r\n            var kebiao = {\"code\":99999,\"msg\":\"未将对象引用设置到对象的实例。\",\"term\":\"2024-2025第2学期\",\"termStart\":\"2025-02-17\",\"termEnd\":\"2025-06-27\",\"today\":\"2026-08-20\"};\r\n            if(kebiao.msg==\"ok\"){\r\n                SetKeBiao(kebiao);\r\n            }\r\n        });\r\n\r\n        window.onload = function(){\r\n            $.post(\"/Student/Home/GetEvents\", data, function (json) {\r\n                if(json.code == 0){\r\n                    var events = $(\"#events\");\r\n                    var ul = events.find(\"div>ul:first\");\r\n                    ul.empty();\r\n                    //待办任务 未读邮件 在借图书 一卡通余额 校园网余额\r\n\r\n                    var todoCount = ConvertToInt(json.todoCount);\r\n                    if(todoCount>0){\r\n                        $(\"#todoCount\").text(todoCount).show();\r\n                        ul.append(\"<li>待办任务：<label>\" + todoCount + \"</label></li>\");\r\n                    }\r\n                    else {\r\n                        $(\"#todoCount\").text(todoCount).hide();\r\n                    }\r\n\r\n                    var newMailCount = ConvertToInt(json.newMailCount);\r\n                    if(newMailCount>0){\r\n                        $(\"#newMailCount\").text(newMailCount).show();\r\n                        ul.append(\"<li>未读邮件：<label>\" + newMailCount + \"</label></li>\");\r\n                    }\r\n                    else{\r\n                        $(\"#newMailCount\").text(newMailCount).hide();\r\n                    }\r\n\r\n                    var borrowCount = ConvertToInt(json.borrowCount);\r\n                    if(borrowCount>0){\r\n                        $(\"#borrowCount\").text(borrowCount).show();\r\n                        ul.append(\"<li>未读邮件：<label>\" + borrowCount + \"</label></li>\");\r\n                    }\r\n                    else{\r\n                        $(\"#borrowCount\").text(borrowCount).hide();\r\n                    }\r\n\r\n\r\n                    var oneDriveStatus = ConvertToIntOrNull(json.oneDriveStatus);\r\n                    var oneDrive = $(\"#oneDrive\");\r\n                    if (oneDriveStatus == 1) {//已开通\r\n                        oneDrive.attr(\"href\",\"https://login.partner.microsoftonline.cn/login.srf/?wa=wsignin1.0&whr=365.yzu.edu.cn&wreply=https://yzu365-my.sharepoint.cn/\");\r\n                        oneDrive.find(\"p\").text(\"在线查看\");\r\n                        oneDrive.find(\"span\").hide();\r\n                    } else if (oneDriveStatus == null) {//未开通\r\n                        oneDrive.attr(\"href\",\"http://o365.yzu.edu.cn/\");\r\n                        oneDrive.find(\"p\").text(\"立即激活\");\r\n                        oneDrive.find(\"img\").attr(\"src\", \"/images/student/onedrive_02_1.png\");\r\n                        oneDrive.find(\"span\").show();\r\n                        ul.append(\"<li><a href='http://o365.yzu.edu.cn/' target='_blank' style='color:#FFF;text-decoration:underline;'>激活 OneDrive 云盘</a></li>\");\r\n                    }\r\n\r\n                    if(json.ecardBalance!=\"\"){\r\n                        var ecardBalance = FormatFloat(json.ecardBalance,2);\r\n                        $(\"#balance\").text(ecardBalance);\r\n                        if(ecardBalance < 20)\r\n                            ul.append(\"<li>一卡通余额：<label>\" + ecardBalance + \"</label>元</li>\");\r\n                    }\r\n\r\n                    if(typeof json.samInfo !=\"undefined\" && json.samInfo.code==0){//校园网信息\r\n                        var data = json.samInfo.data;\r\n                        $(\"#accountFee\").text(data[\"accountFee\"]);\r\n                        $(\"#preAccountFee\").text(data[\"preAccountFee\"]);\r\n                        if(FormatFloat(data[\"accountFee\"]) - FormatFloat(data[\"preAccountFee\"]) < 5){\r\n                            ul.append(\"<li>校园网余额：<label>\" + data[\"accountFee\"] + \"</label>元</li>\");\r\n                        }\r\n                        $(\"#period\").text(FormatDtm(data[\"periodStartTime\"], \"yyyy.MM.dd\") + \" ~ \" + FormatDtm(data[\"periodEndTime\"], \"yyyy.MM.dd\"));\r\n                        $(\"#remainDays\").text(data[\"remainDays\"]);\r\n                        $(\"#freeRemain\").text(data[\"freeRemain\"]);\r\n                    }\r\n\r\n                    var robotImg = $(\"#robotImg\");\r\n                    if(ul.find(\"li\").length>0){\r\n                        $(\"#robotTipHeader\").show();\r\n                        if(page.gender == 1)\r\n                            robotImg[0].src =\"/images/student/HiMale.gif\";\r\n                        else\r\n                            robotImg[0].src =\"/images/student/HiFeMale.gif\";\r\n\r\n                    } else {\r\n                        $(\"#robotTipHeader\").hide();\r\n                        if(page.gender == 1)\r\n                            robotImg[0].src =\"/images/student/HiMale.png\";\r\n                        else\r\n                            robotImg[0].src =\"/images/student/HiFeMale.png\";\r\n                    }\r\n                    var robot = $(\"#robot\");\r\n                    robot.animate({\"right\":\"-1px\"},1500);\r\n                    robotImg.click(function(e){\r\n                        e.stopPropagation();\r\n                        robot.animate({\"right\":\"-230px\"},600,function(){\r\n                            robotImg.hide();\r\n                            events.show();\r\n                            robot.animate({\"right\":\"-1px\"},600);\r\n\r\n                            $(document).bind(\"click.hideEvents\",function(){\r\n                                robot.animate({\"right\":\"-230px\"},600,function(){\r\n                                    events.hide();\r\n                                    robotImg.show();\r\n                                    robot.animate({\"right\":\"-1px\"},600);\r\n                                    $(document).unbind(\"click.hideEvents\");\r\n                                });\r\n                            });\r\n                        });\r\n                    });\r\n                    events.click(function(e){\r\n                        e.stopPropagation();\r\n                    });\r\n                }\r\n            }, \"json\");\r\n\r\n            $.post(\"/Student/Home/GetCWBH\", data, function (cwbh) {\r\n                if(cwbh!=null && cwbh!=\"\"){\r\n                    $(\"#cwbh\").text(cwbh).show();\r\n                    $(\"#cwbh_v_separator\").show();                   \r\n                }\r\n            },\"text\");\r\n\r\n            var eventLinksImgArr = [\"/images/student/todo_02_w.png\",\"/images/student/email_02_w.png\",\"/images/student/borrow_02_w.png\",\"/images/student/onedrive_02_w.png\"]\r\n            $(\"#eventLinks a\").each(function(index,element){\r\n                $(this).hover(function(){\r\n                    var img = $(this).find(\"img\");\r\n                    var src = img[0].src;\r\n                    img[0].src = eventLinksImgArr[index];\r\n                    eventLinksImgArr[index] = src;\r\n                },function(){\r\n                    var img = $(this).find(\"img\");\r\n                    var src = img[0].src;\r\n                    img[0].src = eventLinksImgArr[index];\r\n                    eventLinksImgArr[index] = src;\r\n                });\r\n\r\n            });\r\n\t\r\n            //只要不合符，每次都要检查（人脸上传时，修改 isFaceEnable，可减少检测）\r\n            if(page.isFaceEnable!=1){\r\n                $.post(\"/Teacher/Home/CheckFaceIsEnable\", data, function (json) {\r\n                    if(parseInt(json.code) == 0){\r\n                        page.isFaceEnable = parseInt(json.isFaceEnable);\r\n                        if(page.isFaceEnable == 0){\r\n                            $(\"#faceMsg\").show();\r\n                            faceMsgLayer();\r\n                        }\r\n                    }\r\n                },\"json\")\r\n            }\r\n        }\r\n\r\n        $(window).resize(function(e) {\r\n            faceMsgLayer();\r\n        });\r\n\r\n \r\n        //page.updateMobile = function(){\r\n        //    layer.confirm('若您的企业微信能正常登录，<br/>建议在企业微信中更换手机号<br/>是否在此继续修改？', {\r\n        //        btn: ['继 续',  '取 消'], //按钮\r\n        //        title : \"提醒\"\r\n        //    }, function (index) {\r\n        //        layer.close(index)\r\n        //        page.editPhone();\r\n        //    }, function () {              \r\n        //        //直接关闭\r\n        //    });\r\n        //}\r\n        //修改手机号码弹出层\r\n        page.editPhone = function(){\r\n            var duration = 0;\r\n            var data = { \"__RequestVerificationToken\": page.token };\r\n            $.postSync(\"/Student/Home/GetDuration\", data, function(val){\r\n                duration = ConvertToInt(val);\r\n            },\"text\");\r\n\r\n            var iLayer = layer.open({\r\n                type: 1,\r\n                title: \"修改统一身份认证手机号\",\r\n                skin: \"layerBox\", //自定义弹出层样式，alert层需同时加载“layerAlert”\r\n                area: \"500px\",\r\n                content: $(\"#smart-community__student-tel\"), //这里content是一个DOM，注意：最好该元素要存放在body最外层，否则可能被其它的相对元素所影响\r\n                isOutAnim: false, //关闭层的动画按钮\r\n                resize: false,\r\n                zIndex: 9999,\r\n                btnAlign: 'c',\r\n                success: function (layero, index) { //层弹出后的成功回调方法,两个参数，分别是当前层DOM当前层索引\r\n                    if(duration > 0){\r\n                        $(\"#btnSendSmsCode\").prop(\"disabled\",true).addClass(\"disabled\");\r\n                        countDown(duration);\r\n                    }\r\n                    $(\"#mobile\").val($(\"label#userMobile\").attr(\"data-mobile\")).focus();//.select();\r\n                },\r\n                btn:[\"确定\",\"取消\"],\r\n                yes: function (index, layero) {\r\n                    var mobile = $.trim($(\"#mobile\").val());\r\n                    if(!isMobile(mobile)){\r\n                        layer.alert(\"手机号码错误\",{title:\"提示\"});\r\n                        return false;\r\n                    }\r\n                    var smsCode =$.trim($(\"#smsCode\").val());\r\n                    if(smsCode.length != 6){\r\n                        layer.alert(\"请输入6位验证码\",{title:\"提示\"});\r\n                        return false;\r\n                    }\r\n                    data.mobile = mobile;\r\n                    data.smsCode = smsCode;\r\n                    $.postSync(\"/Student/Home/UpdateMobile\", data, function(json){\r\n                        if(json.code == 0){\r\n                            layer.close(index);\r\n                            layer.msg(\"统一身份认证手机号码已更改\",{time : 1000});\r\n                            $(\"label#userMobile\").attr(\"data-mobile\" , mobile).text(mobile);\r\n                        } else {\r\n                            layer.alert(json.msg, {title : \"提示\"});\r\n                        }\r\n                    },\"json\");\r\n                }\r\n                , btn2: function (index, layero) {\r\n                    return true;\r\n                }\r\n                , end: function () {\r\n                    $(\"#btnSendSmsCode\").prop(\"disabled\",false).removeClass(\"disabled\").text(\"获取验证码\");;\r\n                    $(\"#smsCode\").val(\"\");\r\n                    clearInterval(interval);\r\n                }\r\n            });\r\n        }\r\n\r\n        //20240220新增：title提示框\r\n        var sweetTitles = {\r\n            x: 10,\r\n            y: 20,\r\n            tipElements: \"a,span,img,div,label\",\r\n            noTitle: false,\r\n            init: function() {\r\n                var noTitle = this.noTitle;\r\n                $(this.tipElements).each(function() {\r\n                    $(this).mouseover(function(e) {\r\n                        if (noTitle) {\r\n                            isTitle = true;\r\n                        } else {\r\n                            isTitle = $.trim(this.title) != \"\";\r\n                        }\r\n                        if (isTitle) {\r\n                            this.myTitle = this.title;\r\n                            this.title = \"\";\r\n                            var tooltip = \"<div class='tooltip'><div class='tipsy-arrow tipsy-arrow-n'></div><div class='tipsy-inner'>\" + this.myTitle + \"</div></div>\";\r\n                            $(\"body\").append(tooltip);\r\n                            $(\".tooltip\").css({\r\n                                \"top\": (e.pageY + 10) + \"px\",\r\n                                \"left\": e.pageX + \"px\"\r\n                            }).show(\"fast\");\r\n                        }\r\n                    }).mouseout(function() {\r\n                        if (this.myTitle != null) {\r\n                            this.title = this.myTitle;\r\n                            $(\".tooltip\").remove();\r\n                        }\r\n                    }).mousemove(function(e) {\r\n                        $(\".tooltip\").css({\r\n                            \"top\": (e.pageY + 25) + \"px\",\r\n                            \"left\": e.pageX + \"px\"\r\n                        });\r\n                    });\r\n                });\r\n            }\r\n        };\r\n        $(function() {\r\n            sweetTitles.init();\r\n        });\r\n\r\n\r\n        function sendSmsCode(btn){\r\n            var mobileOri = $(\"label#userMobile\").attr(\"data-mobile\");\r\n            var mobile = $.trim($(\"#mobile\").val());\r\n            if(!isMobile(mobile)){\r\n                layer.alert(\"手机号码错误\",{title:\"提示\"});\r\n                return false;\r\n            }\r\n            //if(mobileOri == mobile){\r\n            //    layer.alert(\"手机号码没有改变，无须提交\",{title:\"提示\"});\r\n            //    return false;\r\n            //}\r\n\r\n            $(btn).prop(\"disabled\",true).addClass(\"disabled\");\r\n            countDown(60);\r\n\r\n            var data ={ \"__RequestVerificationToken\": page.token };\r\n            data.mobile = mobile;\r\n            $.postSync(\"/Student/Home/SendSmsCode\",data,function(msg){\r\n                if(msg == \"ok\"){\r\n                    layer.msg(\"验证码短信已发出\",{time : 2000});\r\n                } else {\r\n                    layer.alert(msg);\r\n                }\r\n            },\"text\");\r\n        }\r\n\r\n        function countDown(duration){\r\n            interval = setInterval(function(){\r\n                if(duration <0){\r\n                    $(\"#btnSendSmsCode\").prop(\"disabled\",false).removeClass(\"disabled\").text(\"获取验证码\");\r\n                    clearInterval(interval);\r\n                } else {\r\n                    $(\"#btnSendSmsCode\").text(\"获取验证码(\"+duration+\"s)\")\r\n                }\r\n                duration--;\r\n            },1000);\r\n        }\r\n\r\n\r\n        //20240422新增（人脸识别失败提示）：\r\n        function faceMsgLayer(){\r\n            if ($(\"#faceMsg\").is(\":visible\")) { \r\n                var portrait = $(\"#portrait\");\r\n                var faceMsgOffset =portrait.offset();\r\n                var faceMsgW = portrait.outerWidth();\r\n                var faceMsgH = portrait.outerHeight();\r\n                var faceMsgLeft;\r\n                faceMsgTop = parseInt(faceMsgOffset.top - faceMsgH + 28);\r\n                faceMsgLeft = parseInt(faceMsgOffset.left + faceMsgW - 30);\r\n                $(\"#faceMsg\").css({\"top\":faceMsgTop +\"px\",\"left\": faceMsgLeft +\"px\"});\r\n            }\r\n        }\r\n    </script>\r\n\r\n    <title>扬帆·云社区</title>\r\n</head>\r\n<body>\r\n    <div id=\"floatAd\" style=\"position:absolute; z-index:100;display:none;\">\r\n        \r\n    </div>\r\n    <div class=\"container\">\r\n        <div class=\"smart-community__head\">\r\n            <div class=\"smart-community__head__con bgFluid\">\r\n<div class=\"smart-community__logo w1260\">\r\n    <div class=\"smart-community__search box-shadow\">\r\n        <input type=\"text\" name=\"keyword\" class=\"keyword\" placeholder=\"应用搜索\" />\r\n        <button class=\"iconfont icon-sousuo search-btn animate\" onclick=\"page.search(this)\"></button>\r\n    </div>\r\n\r\n    <div class=\"smart-community__menu box-shadow unselectable\">\r\n        <ul>\r\n            <li><a href=\"/Student\"><i class=\"iconfont icon-shouye animate\"></i><span>首页</span></a></li>\r\n            <li><a href=\"/Omni\"><i class=\"iconfont icon-banshi animate\"></i><span>办事大厅</span></a></li>\r\n            <li><a href=\"https://ehall.yzu.edu.cn/taskcenter/workflow/todo?headerNow=true\"><i class=\"iconfont icon-renwu animate\"></i><span>任务中心</span></a></li>\r\n            <li><a href=\"/Teacher/PersonalOther\"><i class=\"iconfont icon-icontouxiang animate\"></i><span>个人中心</span></a></li>\r\n        </ul>\r\n    </div>\r\n</div>\r\n\r\n            </div>\r\n            <div class=\"smart-community__banner swiper-container\" id=\"banner\">\r\n                <div class=\"swiper-wrapper\">\r\n                        <div class=\"swiper-slide\"><p style=\"background-image:url(/uploadFile/student/banner01.jpg);\"></p></div>\r\n                        <div class=\"swiper-slide\"><p style=\"background-image:url(/uploadFile/student/banner02.jpg);\"></p></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"faceMsg\" class=\"faceMsg\">人脸照片质量偏低，请点击上传</div>\r\n\r\n        <div class=\"smart-community__student-info-box w1260\">\r\n            <div class=\"smart-community__student-info box-shadow bg-white unselectable\">\r\n                <div class=\"smart-community__current-college\">\r\n                    <a href=\"/Login/Logout\">退出</a>\r\n                    <i class=\"iconfont icon-xueyuan\"></i>\r\n                    <span title=\"信息与人工智能学院（工业软件学院）\">信息与人工智能学院（工业软件学院）</span>\r\n                </div>\r\n\r\n                <div class=\"smart-community__item smart-community__portrait\">\r\n                    <a id=\"portrait\" href=\"/User/EditFace\" class=\"smart-community__portrait__pic\" title=\"点击修改头像/面部照片\">\r\n                        <p style=\"background-image:url('/images/student/none.png');\"></p>\r\n                        <i class=\"iconfont icon-bianji1\"></i>\r\n                    </a>\r\n                    <div class=\"smart-community__portrait__txt\">\r\n                        <ul>\r\n                            <li class=\"smart-community__student-name justify\">苏云骏<span><label title=\"学号\">221302216</label><label id=\"cwbh_v_separator\" class=\"v_separator\" style=\"display:none\">|</label><label id=\"cwbh\" title=\"财务编号\" style=\"display:none\"></label></span></li>\r\n                            <li class=\"smart-community__student-address\">扬子津西校区 驿苑011#223</li>\r\n                            <li class=\"smart-community__student-btn\">\r\n                                <span><i class=\"iconfont icon-tel\"></i><label id=\"userMobile\" data-mobile=\"13004576782\">1300******2</label></span>\r\n                                \r\n                                <a href=\"/User/EditMobile\" title=\"统一身份认证手机号\"><i class=\"iconfont icon-xiugai\"></i>修改</a>\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"smart-community__item smart-community__balance\">\r\n                    <label>校园一卡通<em class=\"bg-orange txt-white hide\">请尽快充值</em></label>\r\n                    <span>\r\n                        余额<a href=\"/WXWDomain/ECard/IndexEhall\" target=\"_blank\">\r\n                            <em id=\"balance\" class=\"txt-green\">--</em>\r\n                            <i class=\"iconfont icon-you\"></i>\r\n                        </a>\r\n                    </span>\r\n                </div>\r\n\r\n                <div class=\"smart-community__item smart-community__my-campus-network\">\r\n                    <h2 id=\"mySchoolNet\"><span><button class=\"iconfont icon-refresh animate\"></button><label id=\"period\"></label></span>我的校园网</h2>\r\n                    <ul>\r\n                        <li><h3>余额</h3><p id=\"accountFee\" class=\"txt-green\">-</p></li>\r\n                        <li><h3>待扣</h3><p id=\"preAccountFee\" class=\"txt-green\">-</p></li>\r\n                        <li><h3>免费时长(分钟)</h3><p id=\"freeRemain\" class=\"txt-green\">-</p></li>\r\n                        <li><h3>剩余天数</h3><p id=\"remainDays\" class=\"txt-green\">-</p></li>\r\n                    </ul>\r\n                </div>\r\n\r\n                <div id=\"eventLinks\" class=\"smart-community__tips\">\r\n                    <a href=\"https://ehall.yzu.edu.cn/taskcenter/workflow/todo?headerNow=true\" target=\"_blank\"><img src=\"/images/student/todo_02.png\" /><p>待办任务</p><span id=\"todoCount\" class=\"bg-orange txt-white\" style=\"display:none\">-</span></a>\r\n                    <a href=\"/Default/EmailLogin\" target=\"_blank\"><img src=\"/images/student/email_02.png\" /><p>未读邮件</p><span id=\"newMailCount\" class=\"bg-orange txt-white\" style=\"display:none\">-</span></a>\r\n                    <a href=\"http://lsp-s.chaoxing.com/login_auth/yzdx/init?isLogout=0&refer=https%3A//findyzu.libsp.cn/find/sso/login/yzu/0?pageType=5\" target=\"_blank\"><img src=\"/images/student/borrow_02.png\" /><p>在借图书</p><span id=\"borrowCount\" class=\"bg-orange txt-white\" style=\"display:none\">-</span></a>\r\n                    <a id=\"oneDrive\" href=\"javascript:void(0)\" title=\"OneDrive\"><img src=\"/images/student/onedrive_02_2.png\" /><p><label style=\"color:#CCC;\">OneDrive</label></p><span class=\"bg-orange txt-white\" style=\"display:none\">待激活</span></a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"smart-community__service-module-group\">\r\n            <div class=\"w1260 unselectable\">\r\n                <div class=\"smart-community__service-module-group__left\">\r\n                    <div class=\"smart-community__notice bg-white box-shadow\">\r\n                        <h2>通知公告</h2>\r\n                        <div class=\"smart-community__notice__con swiper-container\" id=\"notice\">\r\n                            <div class=\"swiper-wrapper\">\r\n                                    <div class=\"swiper-slide ellipsis\"><span>2026-07-14</span><a href=\"http://xgc.yzu.edu.cn/info/1041/3902.htm\" target=\"_blank\" title=\"【通知公告】学生工作部（处）2026年暑期值班表\">【通知公告】学生工作部（处）2026年暑期值班表</a></div>\r\n                                    <div class=\"swiper-slide ellipsis\"><span>2026-07-10</span><a href=\"http://jwc.yzu.edu.cn/info/1002/4578.htm\" target=\"_blank\" title=\"【通知公告】2026年教务处暑假值班表\">【通知公告】2026年教务处暑假值班表</a></div>\r\n                                    <div class=\"swiper-slide ellipsis\"><span>2026-07-09</span><a href=\"http://jwc.yzu.edu.cn/info/1002/4575.htm\" target=\"_blank\" title=\"【通知公告】关于组织参加“第八届中华经典诵写讲大赛”——“笔墨中国”、“印记中国”的通知\">【通知公告】关于组织参加“第八届中华经典诵写讲大赛”——“笔墨中国”、“印记中国”的通知</a></div>\r\n                                    <div class=\"swiper-slide ellipsis\"><span>2026-07-03</span><a href=\"http://jwc.yzu.edu.cn/info/1002/4573.htm\" target=\"_blank\" title=\"【通知公告】关于本科生2026～2027学年秋学期选课的通知\">【通知公告】关于本科生2026～2027学年秋学期选课的通知</a></div>\r\n                                    <div class=\"swiper-slide ellipsis\"><span>2026-06-26</span><a href=\"http://jwc.yzu.edu.cn/info/1002/4564.htm\" target=\"_blank\" title=\"【通知公告】关于组织参加2026年全国大学生数学竞赛（非数学类）培训的通知\">【通知公告】关于组织参加2026年全国大学生数学竞赛（非数学类）培训的通知</a></div>\r\n                                    <div class=\"swiper-slide ellipsis\"><span>2026-06-25</span><a href=\"http://jwc.yzu.edu.cn/info/1002/4563.htm\" target=\"_blank\" title=\"【通知公告】关于选拔本科生参加浙江理工大学交换学习项目的通知\">【通知公告】关于选拔本科生参加浙江理工大学交换学习项目的通知</a></div>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"smart-community__notice__more\"><a href=\"/Student/NewsList\">更多<span>MORE</span></a></div>\r\n                    </div>\r\n\r\n                    <div class=\"smart-community__service bg-white box-shadow\">\r\n                        <div class=\"smart-community__service__list animate\">\r\n                            <img src=\"/images/student/s01.jpg\" class=\"animate\" />\r\n                            <h2 class=\"animate\">思想引领</h2>\r\n                            <ul class=\"app_list\">\r\n                                    <li><a data-id=\"5\" href=\"https://zhtj.youth.cn/zhtj\" target=\"_blank\">智慧团建</a></li>\r\n                                    <li><a data-id=\"4\" href=\"http://news.cyol.com/gb/channels/vrGlAKDl/index.html\" target=\"_blank\">青年大学习</a></li>\r\n                                    <li><a data-id=\"2\" href=\"https://dxs.moe.gov.cn/zx/\" target=\"_blank\">大学生在线</a></li>\r\n                                    <li><a data-id=\"1\" href=\"https://www.yiban.cn/login\" target=\"_blank\">易班</a></li>\r\n                                    <li><a data-id=\"3\" href=\"https://www.xuexi.cn/\" target=\"_blank\">学习强国</a></li>\r\n                            </ul>\r\n                                <p><a href=\"javascript:void(0)\" onClick=\"page.showMoreApp(1)\">MORE</a></p>\r\n                        </div>\r\n\r\n                        <div class=\"sm